+      uint32_t seed = 0;
+      IOSurfaceLock(surf, 0, &seed);
+      IOSurfaceUnlock(surf, 0, &seed);
+
+      CALayer *root = (CALayer *)metal_layer;
+      [CATransaction begin];
+      [CATransaction setDisableActions:YES];
+
+      CALayer *ioLayer = objc_getAssociatedObject(root, &kGP108ZeroCopySublayerKey);
+      if (!ioLayer) {
+         ioLayer = [CALayer layer];
+         ioLayer.anchorPoint = CGPointMake(0.0, 0.0);
+         ioLayer.position = CGPointMake(0.0, 0.0);
+         ioLayer.bounds = root.bounds;
+         ioLayer.contentsScale = root.contentsScale;
+         ioLayer.contentsGravity = kCAGravityResize;
+         ioLayer.opaque = root.opaque;
+         ioLayer.actions = @{
+            @"contents": [NSNull null],
+            @"bounds": [NSNull null],
+            @"position": [NSNull null],
+            @"sublayers": [NSNull null],
+            @"onOrderIn": [NSNull null],
+         };
+         [root addSublayer:ioLayer];
+         objc_setAssociatedObject(root, &kGP108ZeroCopySublayerKey, ioLayer,
+                                  OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+      } else if (!CGRectEqualToRect(ioLayer.bounds, root.bounds)) {
+         ioLayer.bounds = root.bounds;
+         ioLayer.contentsScale = root.contentsScale;
+      }
+
+      ioLayer.contents = (id)surf;
+      [CATransaction commit];
+      [CATransaction flush];
+   }
+}
+
+void
+wsi_metal_layer_cleanup_iosurface(const CAMetalLayer *metal_layer)
+{
+   if (!metal_layer)
+      return;
+   @autoreleasepool {
+      CALayer *root = (CALayer *)metal_layer;
+      CALayer *ioLayer = objc_getAssociatedObject(root, &kGP108ZeroCopySublayerKey);
+      if (ioLayer) {
+         [CATransaction begin];
+         [CATransaction setDisableActions:YES];
+         ioLayer.contents = nil;
+         [ioLayer removeFromSuperlayer];
+         [CATransaction commit];
+         objc_setAssociatedObject(root, &kGP108ZeroCopySublayerKey, nil,
+                                  OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+      }
+   }
+}
