+wsi_metal_create_iosurface(uint32_t width, uint32_t height,
+                           uint32_t row_pitch, uint64_t alloc_size,
+                           VkFormat format, uint32_t *out_iosurface_id)
+{
+   @autoreleasepool {
+      uint32_t pixel_fmt = 'BGRA';
+      uint32_t bpe = 4;
+      switch (format) {
+      case VK_FORMAT_B8G8R8A8_UNORM:
+      case VK_FORMAT_B8G8R8A8_SRGB:
+         pixel_fmt = 'BGRA';
+         bpe = 4;
+         break;
+      case VK_FORMAT_R16G16B16A16_SFLOAT:
+         pixel_fmt = 'RGhA';
+         bpe = 8;
+         break;
+      case VK_FORMAT_A2R10G10B10_UNORM_PACK32:
+      case VK_FORMAT_A2B10G10R10_UNORM_PACK32:
+         pixel_fmt = 'l10r';
+         bpe = 4;
+         break;
+      default:
+         return NULL;
+      }
+
+      NSDictionary *props = @{
+         (id)kIOSurfaceWidth: @(width),
+         (id)kIOSurfaceHeight: @(height),
+         (id)kIOSurfaceBytesPerElement: @(bpe),
+         (id)kIOSurfaceBytesPerRow: @(row_pitch),
+         (id)kIOSurfaceAllocSize: @(alloc_size),
+         (id)kIOSurfacePixelFormat: @(pixel_fmt),
+         (id)kIOSurfaceIsGlobal: @YES,
+      };
+      IOSurfaceRef surf = IOSurfaceCreate((__bridge CFDictionaryRef)props);
+      if (!surf)
+         return NULL;
+
+      IOSurfaceSetValue(surf, CFSTR("IOSurfaceColorSpace"), kCGColorSpaceSRGB);
+      if (out_iosurface_id)
+         *out_iosurface_id = (uint32_t)IOSurfaceGetID(surf);
+      return (void *)surf;
+   }
